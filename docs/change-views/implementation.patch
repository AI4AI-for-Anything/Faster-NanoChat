index 0000000..0e8d5cb
--- /dev/null
+++ b/nanochat/norm_rowpack.py
@@ -0,0 +1,196 @@
+"""Pack independent RMS backward dot-product rows; leave arithmetic intact."""
+import ast
+import copy
+import functools
+import hashlib
+from pathlib import Path
+
+
+# A conservative structural selector, not a replacement kernel. Only the row
+# extent is normalized. Any different indexing or arithmetic uses stock code.
+_BODY = """
+xnumel = 0
+r0_numel = 128
+R0_BLOCK: tl.constexpr = 128
+rnumel = r0_numel
+RBLOCK: tl.constexpr = R0_BLOCK
+xoffset = tl.program_id(0) * XBLOCK
+xindex = xoffset + tl.arange(0, XBLOCK)[:, None]
+xmask = tl.full([XBLOCK, R0_BLOCK], True, tl.int1)
+r0_index = tl.arange(0, R0_BLOCK)[None, :]
+r0_offset = 0
+r0_mask = tl.full([XBLOCK, R0_BLOCK], True, tl.int1)
+roffset = r0_offset
+rindex = r0_index
+r0_1 = r0_index
